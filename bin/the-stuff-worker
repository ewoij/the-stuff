#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# the-stuff-worker — autonomous task worker powered by Claude Code
#
# Usage: the-stuff-worker [project-id] [options]
#
# Options:
#   --server URL               Server URL (default: $THE_STUFF_URL or http://localhost:3000)
#   --base-branch BR           Branch to create worktrees from (default: main)
#   --max-tasks N              Maximum number of tasks to process (default: unlimited)
#   --poll-interval S          Seconds between polling when no tasks available (default: 30)
#   --session-reset-every N    Reset Claude session after N tasks (default: 5, 0 to disable)
#
# Environment:
#   THE_STUFF_URL   Server URL (default: http://localhost:3000)
# ---------------------------------------------------------------------------

SERVER_URL="${THE_STUFF_URL:-http://localhost:3000}"
BASE_BRANCH="main"
MAX_TASKS=""
POLL_INTERVAL=30
SESSION_RESET_EVERY=5
CURRENT_TASK_ID=""
WORKTREE_DIR=""
AGENT_ID=""
AGENT_NAME=""
HEARTBEAT_PID=""
SESSION_ID=""
SESSION_TASK_COUNT=0

# --- Argument parsing ------------------------------------------------------

usage() {
  echo "Usage: the-stuff-worker [project-id] [--server URL] [--base-branch BRANCH] [--max-tasks N] [--poll-interval SECONDS] [--session-reset-every N]"
  echo ""
  echo "If project-id is omitted, you will be prompted to select a project."
  exit 1
}

PROJECT_ID=""

# First arg could be a project ID (numeric) or a flag
if [[ $# -gt 0 && "$1" =~ ^[0-9]+$ ]]; then
  PROJECT_ID="$1"
  shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --server) SERVER_URL="$2"; shift 2 ;;
    --base-branch) BASE_BRANCH="$2"; shift 2 ;;
    --max-tasks) MAX_TASKS="$2"; shift 2 ;;
    --poll-interval) POLL_INTERVAL="$2"; shift 2 ;;
    --session-reset-every) SESSION_RESET_EVERY="$2"; shift 2 ;;
    --help|-h) usage ;;
    *) usage ;;
  esac
done

# --- Project selection (if not provided) ------------------------------------

if [[ -z "$PROJECT_ID" ]]; then
  PROJECTS_RESPONSE=$(curl -s -w "\n%{http_code}" "$SERVER_URL/api/projects")
  PROJECTS_HTTP=$(echo "$PROJECTS_RESPONSE" | tail -1)
  PROJECTS_BODY=$(echo "$PROJECTS_RESPONSE" | sed '$d')

  if [[ "$PROJECTS_HTTP" != "200" ]]; then
    echo "Error: Failed to fetch projects from $SERVER_URL (HTTP $PROJECTS_HTTP)"
    exit 1
  fi

  PROJECT_COUNT=$(echo "$PROJECTS_BODY" | jq 'length')

  if [[ "$PROJECT_COUNT" -eq 0 ]]; then
    echo "No projects found. Create a project first."
    exit 1
  fi

  echo "Select a project:"
  echo ""
  for i in $(seq 0 $((PROJECT_COUNT - 1))); do
    P_ID=$(echo "$PROJECTS_BODY" | jq -r ".[$i].id")
    P_NAME=$(echo "$PROJECTS_BODY" | jq -r ".[$i].name")
    echo "  $((i + 1))) $P_NAME (id: $P_ID)"
  done
  echo ""

  while true; do
    printf "Enter choice [1-%d]: " "$PROJECT_COUNT"
    read -r CHOICE
    if [[ "$CHOICE" =~ ^[0-9]+$ && "$CHOICE" -ge 1 && "$CHOICE" -le "$PROJECT_COUNT" ]]; then
      PROJECT_ID=$(echo "$PROJECTS_BODY" | jq -r ".[$(($CHOICE - 1))].id")
      PROJECT_NAME=$(echo "$PROJECTS_BODY" | jq -r ".[$(($CHOICE - 1))].name")
      echo ""
      echo "Selected: $PROJECT_NAME (id: $PROJECT_ID)"
      break
    fi
    echo "Invalid choice. Please enter a number between 1 and $PROJECT_COUNT."
  done
fi

# --- Cleanup trap ----------------------------------------------------------

stop_heartbeat() {
  if [[ -n "$HEARTBEAT_PID" ]]; then
    kill "$HEARTBEAT_PID" 2>/dev/null || true
    wait "$HEARTBEAT_PID" 2>/dev/null || true
    HEARTBEAT_PID=""
  fi
}

start_heartbeat() {
  local agent_id="$1"
  local task_id="$2"
  stop_heartbeat
  (
    while true; do
      sleep 15
      curl -s -X POST "$SERVER_URL/api/agents/heartbeat" \
        -H 'Content-Type: application/json' \
        -d "{\"agentId\": $agent_id, \"taskId\": $task_id, \"sessionId\": \"$WORKER_SESSION_ID\", \"tasksCompletedInSession\": $TASKS_COMPLETED}" > /dev/null 2>&1 || true
    done
  ) &
  HEARTBEAT_PID=$!
}

cleanup() {
  stop_heartbeat
  if [[ -n "$CURRENT_TASK_ID" ]]; then
    echo ""
    echo "[worker] Releasing task #$CURRENT_TASK_ID (interrupted/crashed)..."
    curl -s -X POST "$SERVER_URL/api/agent/release-task" \
      -H 'Content-Type: application/json' \
      -d "{\"taskId\": $CURRENT_TASK_ID}" > /dev/null 2>&1 || true
    CURRENT_TASK_ID=""
  fi
  if [[ -n "$WORKTREE_DIR" && -d "$WORKTREE_DIR" ]]; then
    echo "[worker] Cleaning up worktree $WORKTREE_DIR..."
    git worktree remove --force "$WORKTREE_DIR" 2>/dev/null || true
    WORKTREE_DIR=""
  fi
  if [[ -n "$AGENT_ID" ]]; then
    echo "[worker] Deregistering agent $AGENT_NAME (#$AGENT_ID)..."
    curl -s -X DELETE "$SERVER_URL/api/agents/$AGENT_ID" > /dev/null 2>&1 || true
    AGENT_ID=""
  fi
}

trap cleanup EXIT INT TERM

# --- Helpers ---------------------------------------------------------------

get_task_status() {
  local task_id="$1"
  curl -s "$SERVER_URL/api/tasks/$task_id" | jq -r '.currentStatus // empty'
}

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//' | cut -c1-40
}

# --- Main loop -------------------------------------------------------------

# --- Agent registration -------------------------------------------------------

REGISTER_RESPONSE=$(curl -s -w "\n%{http_code}" -X POST "$SERVER_URL/api/agents/register" \
  -H 'Content-Type: application/json' \
  -d "{\"projectId\": $PROJECT_ID}")
REGISTER_HTTP=$(echo "$REGISTER_RESPONSE" | tail -1)
REGISTER_BODY=$(echo "$REGISTER_RESPONSE" | sed '$d')

if [[ "$REGISTER_HTTP" != "201" ]]; then
  echo "Error: Failed to register agent (HTTP $REGISTER_HTTP): $REGISTER_BODY"
  exit 1
fi

AGENT_ID=$(echo "$REGISTER_BODY" | jq -r '.id')
AGENT_NAME=$(echo "$REGISTER_BODY" | jq -r '.name')

WORKER_SESSION_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
TASKS_COMPLETED=0

echo "[worker] Registered as $AGENT_NAME (#$AGENT_ID)"
echo "[worker] Worker session: $WORKER_SESSION_ID"
echo "[worker] Starting worker for project #$PROJECT_ID"
echo "[worker] Server: $SERVER_URL"
echo "[worker] Base branch: $BASE_BRANCH"
[[ -n "$MAX_TASKS" ]] && echo "[worker] Max tasks: $MAX_TASKS"
echo "[worker] Poll interval: ${POLL_INTERVAL}s"
if [[ "$SESSION_RESET_EVERY" -gt 0 ]]; then
  echo "[worker] Session reset: every $SESSION_RESET_EVERY tasks"
else
  echo "[worker] Session reset: disabled (single session for entire worker run)"
fi

# Create a single persistent worktree for this worker. All tasks run in this
# same directory (branch-switched between tasks). This keeps Claude's cwd
# stable across tasks so sessions can be resumed (session storage is keyed
# by cwd).
git fetch origin "$BASE_BRANCH" 2>/dev/null || true
git worktree prune 2>/dev/null || true
WORKTREE_DIR="$(mktemp -d)/worker-${AGENT_ID}"
if ! git worktree add --detach "$WORKTREE_DIR" "origin/$BASE_BRANCH" 2>&1; then
  echo "[worker] Failed to create worktree at $WORKTREE_DIR"
  exit 1
fi
echo "[worker] Worktree: $WORKTREE_DIR"
echo ""

TASK_COUNT=0

while true; do
  # 1. Fetch next task
  RESPONSE=$(curl -s -w "\n%{http_code}" -X POST "$SERVER_URL/api/agent/next-task" \
    -H 'Content-Type: application/json' \
    -d "{\"projectId\": $PROJECT_ID, \"agentId\": $AGENT_ID}")

  HTTP_CODE=$(echo "$RESPONSE" | tail -1)
  BODY=$(echo "$RESPONSE" | sed '$d')

  if [[ "$HTTP_CODE" == "404" ]]; then
    echo "[worker] No tasks available, checking again in ${POLL_INTERVAL}s..."
    CURRENT_TASK_ID=""
    # Send heartbeat to keep agent alive while idle
    curl -s -X POST "$SERVER_URL/api/agents/heartbeat" \
      -H 'Content-Type: application/json' \
      -d "{\"agentId\": $AGENT_ID, \"sessionId\": \"$WORKER_SESSION_ID\", \"tasksCompletedInSession\": $TASKS_COMPLETED}" > /dev/null 2>&1 || true
    sleep "$POLL_INTERVAL"
    continue
  fi

  if [[ "$HTTP_CODE" != "200" ]]; then
    echo "[worker] Error fetching task (HTTP $HTTP_CODE): $BODY"
    CURRENT_TASK_ID=""
    exit 1
  fi

  # 2. Extract task fields
  TASK_ID=$(echo "$BODY" | jq -r '.id')
  TASK_TITLE=$(echo "$BODY" | jq -r '.title')
  TASK_CONTENT=$(echo "$BODY" | jq -r '.content // empty')
  TASK_PROJECT_ID=$(echo "$BODY" | jq -r '.projectId')
  TASK_PARENT_ID=$(echo "$BODY" | jq -r '.parentTaskId // empty')

  CURRENT_TASK_ID="$TASK_ID"

  echo "================================================================"
  echo "[worker] Task #$TASK_ID: $TASK_TITLE"
  [[ -n "$TASK_CONTENT" ]] && echo "[worker] Description: $TASK_CONTENT"
  echo "================================================================"

  # 3. Check out the task branch in the persistent worktree
  SLUG=$(slugify "$TASK_TITLE")
  BRANCH_NAME="task-${TASK_ID}/${SLUG}"

  echo "[worker] Checking out branch $BRANCH_NAME in $WORKTREE_DIR"

  git fetch origin "$BASE_BRANCH" 2>/dev/null || true

  BRANCH_EXISTS=false
  if git show-ref --verify --quiet "refs/heads/$BRANCH_NAME" 2>/dev/null || \
     git show-ref --verify --quiet "refs/remotes/origin/$BRANCH_NAME" 2>/dev/null; then
    BRANCH_EXISTS=true
  fi

  EXISTING_PR_URL=""

  # Reset worktree to a clean state before switching branches (defensive —
  # claude should have committed everything, but just in case)
  (
    cd "$WORKTREE_DIR" || exit 1
    git reset --hard 2>/dev/null || true
    git clean -fd 2>/dev/null || true
  )

  if $BRANCH_EXISTS; then
    echo "[worker] Resuming existing branch $BRANCH_NAME"
    if ! (
      cd "$WORKTREE_DIR" || exit 1
      # Fetch latest of the branch from remote, then check it out
      git fetch origin "$BRANCH_NAME" 2>/dev/null || true
      git checkout -B "$BRANCH_NAME" "origin/$BRANCH_NAME" 2>/dev/null || \
        git checkout "$BRANCH_NAME"
      # Rebase onto latest base branch so the worktree is up to date
      git rebase "origin/$BASE_BRANCH" 2>/dev/null || true
    ); then
      echo "[worker] Failed to check out branch. Releasing task."
      curl -s -X POST "$SERVER_URL/api/agent/release-task" \
        -H 'Content-Type: application/json' \
        -d "{\"taskId\": $TASK_ID}" > /dev/null
      CURRENT_TASK_ID=""
      continue
    fi

    # Look up existing PR
    EXISTING_PR_URL=$(cd "$WORKTREE_DIR" && gh pr view "$BRANCH_NAME" --json url -q '.url' 2>/dev/null) || true
    if [[ -n "$EXISTING_PR_URL" ]]; then
      echo "[worker] Found existing PR: $EXISTING_PR_URL"
    fi
  else
    if ! (
      cd "$WORKTREE_DIR" || exit 1
      git checkout -B "$BRANCH_NAME" "origin/$BASE_BRANCH"
    ); then
      echo "[worker] Failed to create branch. Releasing task."
      curl -s -X POST "$SERVER_URL/api/agent/release-task" \
        -H 'Content-Type: application/json' \
        -d "{\"taskId\": $TASK_ID}" > /dev/null
      CURRENT_TASK_ID=""
      continue
    fi
  fi

  echo ""

  # 4. Build prompt
  PR_CONTEXT=""
  if [[ -n "$EXISTING_PR_URL" ]]; then
    PR_CONTEXT=$(cat <<PR_EOF

## Existing PR
This task was previously worked on. There is an existing PR: $EXISTING_PR_URL

**Before doing anything else:**
1. Read the PR comments using: gh pr view $EXISTING_PR_URL --comments
2. Also check inline review comments using: gh api repos/{owner}/{repo}/pulls/{number}/comments
3. Address all feedback from the comments in your implementation

If anything in the comments is unclear or ambiguous:
- Comment back on the PR explaining your interpretation
- Also add a comment on the task using the task manager API:
  curl -s -X POST $SERVER_URL/api/tasks/$TASK_ID/comments \\
    -H 'Content-Type: application/json' \\
    -d '{"content": "<your comment>"}'
PR_EOF
)
  fi

  PROMPT=$(cat <<PROMPT_EOF
You are an autonomous task worker. You have been assigned a task from "The Stuff" task manager.

## Your Task
- Task ID: $TASK_ID
- Project ID: $TASK_PROJECT_ID
- Title: $TASK_TITLE
${TASK_CONTENT:+- Description: $TASK_CONTENT}
${TASK_PARENT_ID:+- Parent Task ID: $TASK_PARENT_ID}
${PR_CONTEXT}

## Environment
- You are working in a git worktree at: $WORKTREE_DIR
- Branch: $BRANCH_NAME (based off $BASE_BRANCH)
- The branch is already created and checked out for you.

## Task Manager API (server: $SERVER_URL)

Complete task (REQUIRED when done):
  curl -s -X POST $SERVER_URL/api/agent/complete-task \\
    -H 'Content-Type: application/json' \\
    -d '{"taskId": $TASK_ID, "branch": "$BRANCH_NAME", "pr": "<pr-url>"}'

Release task (if you cannot complete it):
  curl -s -X POST $SERVER_URL/api/agent/release-task \\
    -H 'Content-Type: application/json' \\
    -d '{"taskId": $TASK_ID}'

Create subtask:
  curl -s -X POST $SERVER_URL/api/agent/create-task \\
    -H 'Content-Type: application/json' \\
    -d '{"projectId": $TASK_PROJECT_ID, "parentTaskId": $TASK_ID, "title": "<title>", "content": "<details>"}'

Add a comment on the task:
  curl -s -X POST $SERVER_URL/api/tasks/$TASK_ID/comments \\
    -H 'Content-Type: application/json' \\
    -d '{"content": "<comment>"}'

## Instructions

Decide whether this task requires **implementation** or **research**:

### Implementation mode (code changes needed)
1. The branch "$BRANCH_NAME" is already checked out — start coding
2. Implement the changes
3. Commit and push: git add <files> && git commit -m "<message>" && git push -u origin $BRANCH_NAME
4. Create a PR (or push to existing): gh pr create --base $BASE_BRANCH --title "<title>" --body "<description>"
   The PR body MUST end with this footer (verbatim, separated from the rest by a blank line and a horizontal rule), so we can audit which model/effort produced the change:

   ---
   - Model: ${MODEL:-<claude default>}
   - Thinking effort: ${EFFORT:-<claude default>}
5. Call complete-task with the branch name and PR URL

### Research mode (investigation only, no code changes)
1. Investigate the codebase or question
2. Create subtask(s) with your findings using the create-task API
3. Call complete-task (without branch/pr since no code was changed)

## Progress Reporting
Post progress comments on the task using the "Add a comment" API at major milestones so that
progress is visible from the task manager UI. Good examples:
- "Created migration and updated schema"
- "Tests passing, creating PR"
- "PR created: <url>"
- "Addressing review feedback: <summary>"
- "Investigation complete — created 3 subtasks"

Do NOT comment on routine steps like reading files, running tests, or searching the codebase.
Aim for 2–4 comments over the lifetime of a task, not one per action.

## Important
- You MUST call either complete-task or release-task before finishing
- If you encounter an error you cannot resolve, call release-task
- Do not ask questions — make your best judgment and proceed
PROMPT_EOF
)

  # 5. Send heartbeat with task ID and start periodic heartbeat
  curl -s -X POST "$SERVER_URL/api/agents/heartbeat" \
    -H 'Content-Type: application/json' \
    -d "{\"agentId\": $AGENT_ID, \"taskId\": $TASK_ID, \"sessionId\": \"$WORKER_SESSION_ID\", \"tasksCompletedInSession\": $TASKS_COMPLETED}" > /dev/null 2>&1 || true
  start_heartbeat "$AGENT_ID" "$TASK_ID"

  # 6. Determine session flags
  # If SESSION_ID is empty or we've hit the reset threshold, start a new session
  if [[ -z "$SESSION_ID" ]] || \
     [[ "$SESSION_RESET_EVERY" -gt 0 && "$SESSION_TASK_COUNT" -ge "$SESSION_RESET_EVERY" ]]; then
    SESSION_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
    SESSION_TASK_COUNT=0
    SESSION_FLAGS=(--session-id "$SESSION_ID")
    echo "[worker] Starting new Claude session: $SESSION_ID"
  else
    SESSION_FLAGS=(--resume "$SESSION_ID")
    echo "[worker] Resuming Claude session: $SESSION_ID (task $((SESSION_TASK_COUNT + 1)) of $SESSION_RESET_EVERY in this session)"
  fi

  # 7. Run Claude Code inside the worktree (with streaming status output)
  # The worktree path is stable across tasks, so sessions can be resumed.
  set +e
  (
    cd "$WORKTREE_DIR"
    claude -p "$PROMPT" --dangerously-skip-permissions \
      "${SESSION_FLAGS[@]}" \
      --verbose --output-format stream-json | \
      jq -r --unbuffered '
        def truncate(n): if length > n then .[:n] + "…" else . end;
        def basename: split("/") | last;
        if .type == "system" and (.subtype // empty) == "" then
          "[claude] Session started"
        elif .type == "assistant" then
          [.message.content[]? | select(.type == "text") | .text |
            split("\n") | map(select(length > 0)) | first // empty |
            truncate(100) |
            "[claude] » " + .
          ] + [.message.content[]? | select(.type == "tool_use") |
            if .name == "Read" or .name == "Glob" or .name == "Grep" then empty
            elif .name == "Bash" then
              "[claude] Bash: " + ((.input.description // (.input.command | split("\n") | first | truncate(80))) | truncate(100))
            elif .name == "Edit" then
              "[claude] Edit " + (.input.file_path | basename)
            elif .name == "Write" then
              "[claude] Write " + (.input.file_path | basename)
            elif .name == "Agent" then
              "[claude] Agent(" + (.input.subagent_type // "general") + ") " + ((.input.description // "") | truncate(80))
            elif .name == "Skill" then
              "[claude] Skill " + (.input.skill // "")
            else
              "[claude] " + .name
            end
          ] | .[]? // empty
        elif .type == "result" then
          "[claude] Done — \(.num_turns // "?") turns, $\(.total_cost_usd // "?")"
        else empty end
      ' 2>/dev/null
  )
  CLAUDE_EXIT=$?
  set -e

  # Track session usage — each Claude call adds to session history
  SESSION_TASK_COUNT=$((SESSION_TASK_COUNT + 1))

  # Stop periodic heartbeat and clear current task
  stop_heartbeat
  curl -s -X POST "$SERVER_URL/api/agents/heartbeat" \
    -H 'Content-Type: application/json' \
    -d "{\"agentId\": $AGENT_ID, \"sessionId\": \"$WORKER_SESSION_ID\", \"tasksCompletedInSession\": $TASKS_COMPLETED}" > /dev/null 2>&1 || true

  # 7. Check if task was completed
  STATUS=$(get_task_status "$TASK_ID")

  if [[ "$STATUS" == "DONE" || "$STATUS" == "ARCHIVED" ]]; then
    echo ""
    echo "[worker] Task #$TASK_ID completed successfully."
    TASK_COUNT=$((TASK_COUNT + 1))
    TASKS_COMPLETED=$TASK_COUNT
    if [[ -n "$MAX_TASKS" && "$TASK_COUNT" -ge "$MAX_TASKS" ]]; then
      echo "[worker] Reached max tasks limit ($MAX_TASKS). Completed $TASK_COUNT task(s)."
      CURRENT_TASK_ID=""
      exit 0
    fi
  elif [[ "$STATUS" == "TODO" ]]; then
    echo ""
    echo "[worker] Task #$TASK_ID was released by Claude."
  else
    # Still PROGRESS — Claude didn't call complete/release
    echo ""
    echo "[worker] Task #$TASK_ID still in PROGRESS (Claude exit code: $CLAUDE_EXIT). Releasing..."
    curl -s -X POST "$SERVER_URL/api/agent/release-task" \
      -H 'Content-Type: application/json' \
      -d "{\"taskId\": $TASK_ID}" > /dev/null
  fi

  # 7. Clear current task (worktree is reused across tasks)
  CURRENT_TASK_ID=""
  echo ""
done
